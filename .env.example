# Development uses a LOCAL Postgres (tools/localdb.sh), never Neon by default [A173].
DATABASE_URL=postgresql://postgres@localhost:5433/iplegends
DIRECT_URL=postgresql://postgres@localhost:5433/iplegends

# Neon, used only through `tools/on-neon.sh <command>`.
#
# NEON_DATABASE_URL - POOLED (host contains "-pooler"). The application.
# NEON_DIRECT_URL   - UNPOOLED. Migrations and all bulk loading: the pooled endpoint
#   runs PgBouncer in transaction mode, which breaks DDL and COPY FROM STDIN.
# Production (Vercel) sets DATABASE_URL/DIRECT_URL to these directly.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/iplegends?sslmode=require
NEON_DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/iplegends?sslmode=require

# Where downloaded archives land. Gitignored.
DATA_DIR=./data

# Signs the auth session cookie (web/auth.py). A long random string -- generate one with:
#   python -c "import secrets;print(secrets.token_hex(32))"
# Never reuse a secret across environments; rotating it invalidates every existing
# session cookie (a harmless, low-stakes forced re-login, not a data-loss event).
SESSION_SECRET=

# Optional. The account_id allowed to discard its own daily attempt and replay the day.
# Unset means the reset route does not exist for anybody, which is the default.
DAILY_RESET_ACCOUNT_ID=

# Optional. Comma-separated account_ids with access to the admin console at /admin [A154].
# Unset or blank: DAILY_RESET_ACCOUNT_ID stands in. Both unset: nobody is an admin.
ADMIN_ACCOUNT_IDS=
