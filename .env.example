# Two Neon endpoints. Both are required.
#
# DATABASE_URL - POOLED (host contains "-pooler"). For the application later.
# DIRECT_URL   - UNPOOLED. For migrations and for all bulk loading.
#
# The pooled endpoint runs PgBouncer in transaction mode, which interferes with
# session-level operations and makes migrations and COPY FROM STDIN unreliable.
# etl.migrate and the loaders connect via DIRECT_URL for that reason.

DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/iplegends?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/iplegends?sslmode=require

# Where downloaded archives land. Gitignored.
DATA_DIR=./data
