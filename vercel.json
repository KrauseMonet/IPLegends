{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "regions": ["bom1"],
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "data/*.json.gz"
      }
    },
    { "src": "web/static/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/static/fonts/(.*)",
      "dest": "/web/static/fonts/$1",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/static/crests/(.*)",
      "dest": "/web/static/crests/$1",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/static/(.*\\.(?:woff2?|ttf|png|jpe?g|webp|svg|ico))",
      "dest": "/web/static/$1",
      "headers": { "cache-control": "public, max-age=2592000, stale-while-revalidate=604800" }
    },
    {
      "src": "/static/(.*\\.(?:css|js))",
      "dest": "/web/static/$1",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    { "src": "/static/(.*)", "dest": "/web/static/$1" },

    { "src": "/sw.js", "dest": "/web/static/sw.js", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/manifest.webmanifest", "dest": "/web/static/manifest.webmanifest", "headers": { "cache-control": "public, max-age=3600" } },
    { "src": "/offline.html", "dest": "/web/static/offline.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },

    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/docs", "dest": "api/index.py" },
    { "src": "/openapi.json", "dest": "api/index.py" },

    { "src": "/", "dest": "/web/static/index.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/draft", "dest": "/web/static/draft.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/season", "dest": "/web/static/season.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/auction", "dest": "/web/static/auction.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/daily", "dest": "/web/static/daily.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/rooms", "dest": "/web/static/rooms.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/rooms/[^/]+", "dest": "/web/static/room.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/profile", "dest": "/web/static/profile.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/admin", "dest": "/web/static/admin.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/records", "dest": "/web/static/records.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/flashback", "dest": "/web/static/flashback.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/puzzles", "dest": "/web/static/puzzles.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/bingo", "dest": "/web/static/bingo.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/chain", "dest": "/web/static/chain.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/xi", "dest": "/web/static/xi.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/guess", "dest": "/web/static/guess.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/about", "dest": "/web/static/about.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/faq", "dest": "/web/static/faq.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/terms", "dest": "/web/static/terms.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/privacy", "dest": "/web/static/privacy.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },

    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
